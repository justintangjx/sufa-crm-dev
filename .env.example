# Copy to .env.local and fill in values from your Supabase project settings.
# Vite only exposes variables prefixed with VITE_ to the client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Leave false/omitted until Supabase migrations, the structure-coach-notes Edge
# Function, model secrets, and live eval checks are deployed. Mock mode and tests exercise
# the full Evaluation copilot without remote infrastructure.
VITE_ENABLE_COACH_LLM=false

# Enables the audited Player Growth Matrix workflow on Supabase-backed deployments.
# Mock mode enables this automatically for local demos/tests.
VITE_ENABLE_PLAYER_GROWTH_MATRIX=false

# Enables the U24 campaign live evaluation matrix after the supporting migration is applied.
# Mock mode enables this automatically for local demos/tests.
VITE_ENABLE_CAMPAIGN_EVALUATION_MATRIX=false

# Enables the end-of-campaign questionnaire (Likert / NPS retrospective) after migration.
# Replaces peer-rating campaign_nps for U24 pilot when on. Mock mode enables automatically.
VITE_ENABLE_CAMPAIGN_QUESTIONNAIRE=false

# Legacy peer-rating NPS (0–10 per coach/player). Off when questionnaire flag is on.
# Mock mode enables this automatically for local demos/tests.
VITE_ENABLE_CAMPAIGN_NPS=false

# Travel/passport profile fields and admin passport columns. Off for U24 pilot (default).
# VITE_ENABLE_TRAVEL_READINESS=true

# Hybrid demo:
# Run supabase/seed-demo-coach.sql, deploy structure-coach-notes + demo-coach-session, then:
# VITE_USE_MOCK=true
# VITE_DEMO_COACH_LLM=true
# VITE_COACH_DEMO_GATE_TOKEN=your-public-demo-gate-token
# VITE_DEMO_COACH_LLM_ID_MAP={"c-sea":"c0000000-0000-4000-8000-000000000001","a-alice":"a0000000-0000-4000-8000-000000000001","a-ben":"a0000000-0000-4000-8000-000000000002","a-cara":"a0000000-0000-4000-8000-000000000003"}
